          "at": 950,
          "amount": 10
        },
        {
          "at": 990,
          "amount": 10
        }
      ],
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "VELOCITY"
      }
    },
    {
