      "prior_txns": [
        {
          "at": 900,
          "amount": 10
        },
        {
          "at": 950,
          "amount": 10
        },
        {
          "at": 990,
          "amount": 10
        }
      ],
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": true,
        "check": "WITHIN"
