        "bounds": {
          "max_amount": 500
        }
      },
      "registry": {
        "revoked": [
          "m-reg"
        ]
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "REVOKED_REGISTRY"
      }
    },
    {
