      "desc": "cumulative budget exceeded",
      "mandate": {
        "bounds": {
          "max_amount": 500,
          "total_budget": 900,
          "budget_window_days": 30
        }
      },
      "prior_txns": [
        {
          "at": 800,
          "amount": 420
        },
        {
          "at": 900,
          "amount": 400
        }
      ],
      "tx": {
        "payee": "x",
        "amount": 100,
        "at": 1000,
        "currency": "GBP"
