        "bounds": {
          "max_amount": 500,
          "total_budget": 900,
          "budget_window_days": 30
        }
      },
      "prior_txns": [
        {
          "at": 900,
          "amount": 400
        }
      ],
      "tx": {
        "payee": "x",
        "amount": 600,
        "at": 1000,
        "currency": "GBP"
      },
      "then_tx": {
        "payee": "x",
        "amount": 500,
        "at": 1001,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "CAP_EXCEEDED"
      },
      "then_expect": {
        "allowed": true,
        "check": "WITHIN"
      }
    },
    {
