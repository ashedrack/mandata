      "mandate": {
        "revoked": true,
        "bounds": {
          "max_amount": 500,
          "expires_in_days": 1
        }
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 90000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "REVOKED"
