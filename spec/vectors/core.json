      "desc": "revoked in attached registry",
      "mandate": {
        "mandate_id": "m-reg",
        "bounds": {
          "max_amount": 500
        }
      },
      "registry": {
        "revoked": [
          "m-reg"
        ]
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "REVOKED_REGISTRY"
      }
    },
    {
      "id": "V21",
      "desc": "registry unreachable - fail closed",
      "mandate": {
        "mandate_id": "m-reg",
        "bounds": {
          "max_amount": 500
        }
      },
      "registry": {
        "unavailable": true
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "REVOKED_REGISTRY"
      }
    },
    {
