      "mandate": {
        "bounds": {
          "max_amount": 500,
          "total_budget": 900,
          "budget_window_days": 30
        }
      },
      "prior_txns": [
        {
          "at": 800,
          "amount": 420
        },
        {
          "at": 900,
          "amount": 400
        }
      ],
      "tx": {
        "payee": "x",
        "amount": 80,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": true,
        "check": "WITHIN"
      }
    },
    {
      "id": "V16",
      "desc": "budget outside window does not count",
      "mandate": {
        "bounds": {
          "max_amount": 500,
          "total_budget": 900,
          "budget_window_days": 1
        }
      },
      "prior_txns": [
        {
          "at": 100,
          "amount": 850
        }
      ],
      "tx": {
        "payee": "x",
        "amount": 100,
        "at": 100000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": true,
        "check": "WITHIN"
      }
    },
    {
      "id": "V17",
      "desc": "negative amount rejected",
      "mandate": {
        "bounds": {
          "max_amount": 500
        }
      },
      "tx": {
        "payee": "x",
        "amount": -50,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "NON_POSITIVE"
      }
    },
    {
      "id": "V18",
      "desc": "revoked overrides in-bounds tx \u2014 first check wins",
      "mandate": {
        "revoked": true,
        "bounds": {
          "max_amount": 500,
          "allowed_payees": [
            "x"
          ]
        }
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "REVOKED"
      }
    },
    {
      "id": "V19",
      "desc": "denied tx does not consume budget",
