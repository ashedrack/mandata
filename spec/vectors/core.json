{
  "version": "mmf-v0.3",
  "description": "Core conformance vectors (amounts are integers in minor units, MMF-v0.3 \u00a73.1) - one per check plus boundary and ordering cases. prior_txns seed state before evaluation (allowed records only). registry.revoked lists mandate_ids revoked in an attached registry; registry.unavailable=true means every registry lookup fails.",
  "vectors": [
    {
      "id": "V01",
      "desc": "within bounds",
      "mandate": {
        "bounds": {
          "max_amount": 50000,
          "currency": "GBP",
          "allowed_payees": [
            "tesco.com"
          ],
          "expires_in_days": 30,
          "velocity_limit": 0
        }
      },
      "tx": {
        "payee": "tesco.com",
        "amount": 4999,
        "currency": "GBP",
        "at": 1000
      },
      "expect": {
        "allowed": true,
        "check": "WITHIN"
      }
    },
    {
      "id": "V02",
      "desc": "locally revoked",
      "mandate": {
        "revoked": true,
        "bounds": {
          "max_amount": 500
        }
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "REVOKED"
      }
    },
    {
      "id": "V03",
      "desc": "expired",
      "mandate": {
        "bounds": {
          "max_amount": 500,
          "expires_in_days": 1
        }
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 90000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "EXPIRED"
      }
    },
    {
      "id": "V04",
      "desc": "non-positive amount",
      "mandate": {
        "bounds": {
          "max_amount": 500
        }
      },
      "tx": {
        "payee": "x",
        "amount": 0,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "NON_POSITIVE"
      }
    },
    {
      "id": "V05",
      "desc": "amount over cap",
      "mandate": {
        "bounds": {
          "max_amount": 500
        }
      },
      "tx": {
        "payee": "x",
        "amount": 501,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": false,
        "check": "CAP_EXCEEDED"
      }
    },
    {
      "id": "V06",
      "desc": "amount exactly at cap \u2014 boundary allowed",
      "mandate": {
        "bounds": {
          "max_amount": 500
        }
      },
      "tx": {
        "payee": "x",
        "amount": 500,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": true,
        "check": "WITHIN"
      }
    },
    {
      "id": "V07",
      "desc": "currency mismatch",
      "mandate": {
        "bounds": {
          "max_amount": 500,
          "currency": "GBP"
        }
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "currency": "USD",
        "at": 1000
      },
      "expect": {
        "allowed": false,
        "check": "CURRENCY"
      }
    },
    {
      "id": "V08",
      "desc": "currency omitted \u2014 no currency check",
      "mandate": {
        "bounds": {
          "max_amount": 500,
          "currency": "GBP"
        }
      },
      "tx": {
        "payee": "x",
        "amount": 10,
        "at": 1000,
        "currency": "GBP"
      },
      "expect": {
        "allowed": true,
        "check": "WITHIN"
      }
    },
    {
      "id": "V09",
      "desc": "payee not in allowlist",
      "mandate": {
        "bounds": {
          "max_amount": 500,
          "allowed_payees": [
