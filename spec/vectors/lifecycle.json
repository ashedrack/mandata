          },
          "expect": {
            "allowed": true,
            "check": "WITHIN"
          }
        },
        {
          "claim": {
            "tx_id": "t1",
            "payee": "x",
            "amount": 10,
            "currency": "GBP"
          },
          "at": 1001,
          "expect": {
            "status": "CLAIMED"
          }
        },
        {
          "void": "t1",
          "at": 1002,
          "expect": {
            "error": true
          }
        },
        {
          "void": "t1",
          "at": 1003,
          "expect": {
            "status": "VOIDED"
