{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mandata Mandate Format v0.3",
  "$defs": {
    "amount": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "mandate": {
      "type": "object",
      "required": ["mandate_id", "principal", "agent", "issued_at", "revoked", "bounds"],
      "properties": {
        "mandate_id": {"type": "string"},
        "principal": {"type": "string"},
        "agent": {"type": "string"},
        "issued_at": {"type": "number"},
        "revoked": {"type": "boolean"},
        "parent_mandate_id": {"type": ["string", "null"]},
        "bounds": {
          "type": "object",
          "required": ["max_amount", "currency", "allowed_payees", "expires_in_days", "velocity_limit"],
          "properties": {
            "max_amount": {"$ref": "#/$defs/amount"},
            "currency": {"type": "string", "minLength": 1},
            "allowed_payees": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "expires_in_days": {"type": "integer", "minimum": 1},
            "velocity_limit": {"type": "integer", "minimum": 0},
            "total_budget": {"oneOf": [{"$ref": "#/$defs/amount"}, {"type": "null"}]},
            "budget_window_days": {"type": "integer", "minimum": 1, "default": 30}
          }
        }
      }
    },
    "transaction": {
      "type": "object",
      "required": ["tx_id", "payee", "amount"],
      "properties": {
        "tx_id": {"type": "string", "minLength": 1},
        "payee": {"type": "string"},
        "amount": {"$ref": "#/$defs/amount"},
        "currency": {"type": "string", "minLength": 1},
        "at": {"type": "number"}
      }
    }
  },
  "$ref": "#/$defs/mandate"
}
