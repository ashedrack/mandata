{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mandata Mandate Format v0.1",
  "type": "object",
  "required": ["mandate_id", "principal", "agent", "issued_at", "revoked", "bounds"],
  "properties": {
    "mandate_id": {"type": "string"},
    "principal": {"type": "string"},
    "agent": {"type": "string"},
    "issued_at": {"type": "number"},
    "revoked": {"type": "boolean"},
    "parent_mandate_id": {"type": ["string", "null"]},
    "bounds": {
      "type": "object",
      "required": ["max_amount", "currency", "allowed_payees", "expires_in_days", "velocity_limit"],
      "properties": {
        "max_amount": {"type": "number", "exclusiveMinimum": 0},
        "currency": {"type": "string"},
        "allowed_payees": {"type": "array", "items": {"type": "string"}},
        "expires_in_days": {"type": "integer", "minimum": 1},
        "velocity_limit": {"type": "integer", "minimum": 0},
        "total_budget": {"type": ["number", "null"]},
        "budget_window_days": {"type": "integer", "minimum": 1}
      }
    }
  }
}
