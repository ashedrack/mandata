{
  "version": "mmf-v0.5-draft",
  "status": "DRAFT, not normative, not wired into the test suite. See spec/drafts/mmf-v0.5-clamp-proposal.md",
  "description": "Clamp to cap vectors, lifecycle format (same step grammar as spec/vectors/lifecycle.json). bounds.clamp is the proposed field. Extra expect keys: clamped, requested_amount, effective_amount, effective_cap. Check values on clamped decisions follow Shape 2 (check names CAP_EXCEEDED, allowed true). For Shape 1, replace CAP_EXCEEDED with WITHIN wherever clamped is true. Amounts are integers in minor units.",
  "vectors": [
    {
      "id": "K01",
      "desc": "clamp on: over cap request is authorized at the cap, check names the bound, record carries the effective amount",
      "mandate": {
        "mandate_id": "m1",
        "bounds": {
          "max_amount": 50000,
          "currency": "GBP",
          "allowed_payees": [
            "tesco.com"
          ],
          "expires_in_days": 30,
          "velocity_limit": 0,
          "clamp": true
        }
      },
      "steps": [
        {
          "tx": {
            "tx_id": "t1",
            "payee": "tesco.com",
            "amount": 60000,
            "at": 1000,
            "currency": "GBP"
          },
          "expect": {
            "allowed": true,
            "check": "CAP_EXCEEDED",
            "status": "AUTHORIZED",
            "clamped": true,
            "requested_amount": 60000,
            "effective_amount": 50000,
            "effective_cap": 50000,
            "record": {
              "amount": 50000,
              "allowed": true,
              "check": "CAP_EXCEEDED"
            }
          }
        }
      ],
      "events": [
        "DECISION"
      ]
    },
    {
