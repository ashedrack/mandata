    {
      "id": "K16",
      "desc": "claim binds the effective amount: claiming the requested amount fails as CLAIM:BINDING, claiming the effective amount succeeds",
      "mandate": {
        "mandate_id": "m1",
        "bounds": {
          "max_amount": 50000,
          "currency": "GBP",
          "allowed_payees": [
