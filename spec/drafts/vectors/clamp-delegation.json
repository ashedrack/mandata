        },
        {
          "tx": {
            "as": "c",
            "payee": "tesco.com",
            "amount": 50,
            "currency": "GBP",
            "at": 2002
          },
          "expect": {
            "allowed": false,
            "check": "BUDGET",
            "clamped": false
          }
        }
      ]
    }
  ]
}
